# Claude Code's per-machine permission allowlist. It records absolute paths
# from whichever machine it was written on, so it is never portable.
.claude/settings.local.json

# OS and editor droppings
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# The game itself is one HTML file and its assets — nothing about it is built
# or installed. These are for the tooling under tools/.
node_modules/
package-lock.json

# Test extracts: slices of index.html, re-cut from it on every run. Derived,
# never the source of truth, and committing them would let a stale copy pass
# while the real file was broken.
tools/test/build/

# Screenshots from tools/test/shoot.js — regenerated on demand, and large.
# Anything worth keeping goes in docs/screenshots/ deliberately.
tools/test/shots/

# Simulation output. Regenerated by tools/sim/career.js; the findings that
# matter get written up rather than left as a dump.
tools/sim/*.txt
tools/sim/*.json
